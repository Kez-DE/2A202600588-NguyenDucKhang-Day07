# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_PROVIDER=openai

# Optional: set cache directories for the local all-MiniLM-L6-v2 embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Ollama local embedding configuration
# OLLAMA_BASE_URL=Your Ollama base URL
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# OLLAMA_CHAT_MODEL=qwen3.5:0.8b
# CHAT_LOG_PATH=logs/chat_history.jsonl

# Optional: local API for Lovable or another UI
# API_HOST=127.0.0.1
# API_PORT=8000
# API_DOC_DIR=data/python_official_docs
# API_METADATA_PATH=data/python_official_docs_metadata.json
# API_LOG_PATH=logs/api_chat_history.jsonl
# API_CHUNK_SIZE=700
# API_CORS_ORIGIN=*

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
